# Copy to configs/servers/server4.env (git-ignored) and edit for the machine. Sourced by scripts/servers/run_4gpu.sh.
# Every path must be absolute. PICAAD_OUT_ROOT must be OUTSIDE the Git checkout (the wrapper refuses otherwise).
PICAAD_PYTHON=/path/to/conda/envs/picaad/bin/python
PICAAD_DATA_ROOT=/srv/picaad/data_npz            # contains PSM/PSM.npz, SMD/machine-*.npz, SWaT51/swat.npz (51 channels)
PICAAD_PRIOR_CACHE=/srv/picaad/prior_cache       # shared PCMCI+ cache for this server
PICAAD_OUT_ROOT=/srv/picaad/runs/cfval/server4   # campaign/server specific; NOT under the checkout
PICAAD_LOCK_DIR=/tmp/picaad_gpu_locks            # per-machine GPU locks (only launchers on THIS machine share it)
PICAAD_GPUS=0,1,2,3                       # physical GPU indices this wrapper may use (default for server4)
PICAAD_CAMPAIGN=cfval                            # tmux session and log naming
PICAAD_CODE_SHA=                                 # required: full or short SHA the run must be executed from (checked against HEAD)
PICAAD_THREADS_PER_JOB=4
PICAAD_DATALOADER_WORKERS=0
PICAAD_PRIOR_WORKERS=1
